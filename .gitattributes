# Auto-detect text files and normalize line endings
* text=auto

# Text formats used by this repository
*.md text
*.txt text
*.json text
*.jsonl text
*.yaml text
*.yml text

# Force LF for shell scripts and CI configuration
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist overrides
*.min.js linguist-generated
*.min.css linguist-generated
